{
  "name": "portfolio-frontend",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "astro preview",
    "check": "astro check",
    "tsc": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.astro",
    "format": "prettier --write .",
    "verify": "npm run format && npm run lint && npm run tsc && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "disable-cache": "node scripts/clear-cache.js",
    "deploy": "npm run build && aws s3 sync dist/ s3://portfolio-frontend-mk && npm run disable-cache",
    "spec:d": "npx -y @pimzino/spec-workflow-mcp --dashboard --port=2345",
    "spec:s": "npx -y @pimzino/spec-workflow-mcp ${pwd} --port=2345",
    "spec": "concurrently -c blue,green \"npm run spec:d\" \"sleep 3 && npm run spec:s\""
  },
  "dependencies": {
    "astro": "^5.1.1",
    "gsap": "^3.12.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/three": "^0.170.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.50.0"
  }
}
