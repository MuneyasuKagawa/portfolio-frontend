---
import BaseLayout from "@/layouts/BaseLayout.astro";

const locale = "ja";
---

<BaseLayout
  title="楠 宗泰 | Developer & Designer"
  description="楠 宗泰のポートフォリオ - フルスタック開発者 & UI/UXデザイナー"
  locale={locale}
>
  <main class="container mx-auto px-4">
    <section class="flex min-h-screen items-center justify-center">
      <div class="text-center">
        <h1
          class="font-display text-foreground text-5xl font-bold tracking-tight md:text-7xl"
        >
          楠 宗泰
        </h1>
        <p class="text-muted mt-6 text-xl">
          フルスタック開発者 & UI/UXデザイナー
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
